# MargRakshak AI Backend Configuration

# Application
APP_NAME="MargRakshak AI - Accident Hotspot Detection"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True
API_V1_PREFIX="/api/v1"

# Server
HOST="0.0.0.0"
PORT=8000

# CORS (Allow Vite frontend)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Database Configuration - Serverless SQLite (Default: fast, self-contained, zero-configuration)
DATABASE_URL="sqlite:///./margrakshak.db"


# Security & JWT
JWT_SECRET_KEY="your_super_secret_jwt_key_change_in_production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ADMIN_EMAIL="admin@margrakshak.in"

# File Uploads
UPLOAD_DIR="uploads"
MAX_UPLOAD_SIZE_MB=15

# Live Traffic & Routing Provider (Optional Google/TomTom API key, falls back to intelligent Nashik traffic model)
GOOGLE_MAPS_API_KEY=""
GOOGLE_ROUTES_API_KEY=""
TOMTOM_API_KEY=""
MAPBOX_ACCESS_TOKEN=""
TRAFFIC_PROVIDER="auto"
